# Clip selection (the "what will go viral" step)
SELECT_PROVIDER=gemini
GEMINI_API_KEY=your-key-here
GEMINI_SELECT_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_SELECT_MODEL=gpt-4o

# Transcription.
#   gemini -> no local model, segment timing interpolated to words
#   local  -> free faster-whisper on your Mac, tighter caption sync
#   openai -> whisper-1, true word timestamps (needs OPENAI_API_KEY)
TRANSCRIBE_PROVIDER=gemini
LOCAL_WHISPER_MODEL=small.en

# Source download ceiling. 1080 keeps the 9:16 crop sharp; 720 downloads
# roughly a third as much, which matters on multi-hour videos.
MAX_HEIGHT=1080

# --- YouTube Shorts upload (handled by the local n8n workflow) ---
# Clipper never calls YouTube itself: it keeps the queue, n8n does the posting.
YT_PRIVACY=public
PUBLIC_URL=http://localhost:8000
N8N_WEBHOOK_URL=http://localhost:5678/webhook/clipper-upload

# How many uploads Clipper will hand out per rolling 24h. This is Clipper's own
# brake, not YouTube's: an upload costs 1600 of a project's 10000 daily quota
# units, so a default project runs dry after 6. Past that YouTube answers
# quotaExceeded and the clip is marked failed, ready to retry tomorrow.
YT_DAILY_LIMIT=10

# --- Housekeeping ---
# Working files (extracted audio, caption files, download leftovers) are always
# deleted once a job renders. These two are the bigger calls:
#   CLEAN_SOURCE_AFTER_RENDER - drop the multi-GB source as soon as clips exist.
#     Off by default: re-rendering a clip later would re-download the video.
#   CLEAN_CLIP_AFTER_UPLOAD   - drop a clip's mp4 once it is on YouTube.
CLEAN_SOURCE_AFTER_RENDER=false
CLEAN_CLIP_AFTER_UPLOAD=true
