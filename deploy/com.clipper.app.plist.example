<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.clipper.app</string>

    <key>ProgramArguments</key>
    <array>
        <string>/ABSOLUTE/PATH/TO/clipper/.venv/bin/uvicorn</string>
        <string>app.main:app</string>
        <string>--host</string>
        <string>::1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <!-- ::1, not 127.0.0.1: on macOS "localhost" resolves to IPv6 first, and
         Node (which n8n runs on) does not fall back to IPv4. Bound to IPv4
         only, every n8n call failed with ECONNREFUSED while curl and the
         browser worked, because those do fall back. Loopback either way. -->
    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/clipper</string>

    <!-- launchd starts with a bare PATH; yt-dlp and ffmpeg live in Homebrew's. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/clipper/data/server.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/clipper/data/server.log</string>
</dict>
</plist>
